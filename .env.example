# Credentials used by the deploy script and the setup wizard.
#
# These are read by tooling that runs on YOUR machine. They are never bundled
# into the Worker, never uploaded, and never logged.
#
# Copy this file to `.env` and paste your token after the `=` on the matching
# line. `.env` is ignored by git; only this example file is tracked.
#
#     cp .env.example .env

# Cloudflare API token. Create one at:
#   https://dash.cloudflare.com/profile/api-tokens  ->  Create Token
#
# Minimum permissions required:
#   Account -> Workers Scripts        -> Edit
#   Account -> Workers KV Storage     -> Edit
#   Account -> Account Settings       -> Read     (to discover your account id)
#
# Only if you attach a custom domain, additionally:
#   Zone    -> DNS                    -> Edit
#   Zone    -> Zone                   -> Read
#
# Do not grant more than this. A token with broader scope is a larger loss if
# it leaks, and nothing here needs it.
CLOUDFLARE_API_TOKEN=

# Optional. Leave blank to have the tooling discover it from the token.
# Only needed if your token can see more than one account.
CLOUDFLARE_ACCOUNT_ID=
